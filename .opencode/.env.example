# PAI environment file
#
# Copy this file to `.opencode/.env` (the same file as `~/.opencode/.env`) and fill in
# only what you use. Every key is optional: a missing key turns off the tool that
# needs it, nothing else. The file is git-ignored; never commit it.
#
# How keys reach the tools: nothing loads this file into the engine. OpenCode,
# Claude Code and the `pai` launcher all start without it. Each tool reads the file
# itself, or its workflow tells the agent to `source` it first. Keys marked (env)
# are read only from the process environment; run those tools after
#   set -a; . ~/.opencode/.env; set +a
#
# Model logins are not here. OpenCode: `/connect` inside a session. Claude Code:
# `/login`. Keys in this file are for researchers, skills and tools.
#
# `pai keys` lists which keys are set, without showing any value.
#
# Each `# ## Group` line starts a group; `pai keys` shows the groups in this order.

# ## Research agents
# `switch-provider.ts <profile> --multi-research` gives each researcher its own model
# family when its key is here (`.opencode/profiles/researchers.yaml`). Without the
# key, the researcher falls back to the primary profile. Pay-per-token API keys:
# a Claude subscription does not cover ANTHROPIC_API_KEY.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://console.x.ai/
XAI_API_KEY=
# https://fireworks.ai/account/api-keys — Codex-, Gemini- and PerplexityResearcher
# run on Fireworks model families.
FIREWORKS_API_KEY=

# ## Email reports
# MineReflections sends its reports over Gmail SMTP. Use an
# app password (https://myaccount.google.com/apppasswords), not your Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Defaults to GMAIL_USER.
REPORT_RECIPIENT=

# ## Homelab
# The Infrastructure skills. Fill in the services you run; the skill for a service
# you leave empty says so when you ask for it.
# Proxmox VE API token: user@realm!tokenname, and its secret.
PROXMOX_API_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
# Portainer (DockerPortainer). SSH to the Docker host defaults to the alias `docker`
# in ~/.ssh/config; set DOCKER_SSH_HOST (user@host) otherwise.
PORTAINER_API_URL=
PORTAINER_API_KEY=
DOCKER_SSH_HOST=
# TrueNAS.
TRUENAS_API_URL=
TRUENAS_API_KEY=
# Technitium DNS. TLS verify defaults to true; set false for a self-signed cert.
TECHNITIUM_API_URL=
TECHNITIUM_API_TOKEN=
TECHNITIUM_TLS_VERIFY=
# Gitea or GitLab, for filing issues about PAI itself (guide/issue-tracking.md). Set
# the one you use. The URLs are the host only; the recipes add /api/v1 or /api/v4.
GITEA_API_URL=
GITEA_TOKEN=
GITLAB_URL=
GITLAB_TOKEN=

# ## Security and OSINT
# Recon: IPinfo and ProjectDiscovery (env).
IPINFO_API_KEY=
PDCP_API_KEY=
# WebAssessment OSINT tools (osint-api-tools.py, needs python-dotenv).
SHODAN_API_KEY=
DEHASHED_API_KEY=
DEHASHED_EMAIL=
OSINT_INDUSTRIES_API_KEY=
# The osint Automation workflow (env).
HIBP_API_KEY=
HUNTER_API_KEY=

# ## Other tools
# Audio transcription: ExtractTranscript, SplitAndTranscribe (env).
OPENAI_API_KEY=
# Parser's Gemini workflows (env).
GEMINI_API_KEY=
# RemoveBg.
REMOVEBG_API_KEY=
# YouTubeApi.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# PAIUpgrade: a GitHub token raises the API rate limit (env). With Issues: read and
# write on your PAI repository, it also files issues there (guide/issue-tracking.md).
GITHUB_TOKEN=
# RelationshipReflect push notifications via ntfy (env).
NTFY_TOPIC=
# PipelineOrchestrator's monitor (env).
MONITOR_URL=
